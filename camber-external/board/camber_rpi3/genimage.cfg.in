image boot.vfat {
	vfat {
		files = {
#BOOT_FILES#
		}
	}

	size = 32M
}

image data.ext4 {
  ext4 {
    label = "data"
    use-mke2fs = true
  }
  mountpoint = "/usr/local"
  size = 128M
}


image sdcard.img {
	hdimage {
	  disk-signature = 0x8977c583
          align = 1M
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition rootfs {
		partition-type = 0x83
		image = "rootfs.ext4"
	}

  partition data {
    partition-type = 0x83
    image = "data.ext4"
  }
}
